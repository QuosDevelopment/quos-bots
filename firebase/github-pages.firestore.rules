rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // These records appear on a public GitHub Pages dashboard. Do not place
    // sensitive prompts, source content, personal information, or credentials here.
    match /quosBots/runtimeState {
      allow read: if true;
      allow write: if false;
      match /botProfiles/{id} { allow read: if true; allow write: if false; }
      match /tasks/{id} { allow read: if false; allow write: if false; }
      match /earnings/{id} { allow read: if false; allow write: if false; }
      match /publicTasks/{id} { allow read: if true; allow write: if false; }
      match /publicEarnings/{id} { allow read: if true; allow write: if false; }
      match /knowledge/{id} { allow read: if false; allow write: if false; }
      match /reports/{id} { allow read: if false; allow write: if false; }
      match /runs/{id} { allow read: if false; allow write: if false; }
    }

    match /dashboardTasks/{id} { allow read, write: if false; }
    match /dashboardControls/{personaId} { allow read: if true; allow write: if false; }
    match /dashboardOperators/{id} { allow read, write: if false; }

    // Browser-only QUOS workspace: the public dashboard can render sanitized
    // persona/task status, while detailed brain records remain operator-private.
    match /browserTasks/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /browserBotStatuses/{personaId} {
      allow read: if true;
      allow write: if false;
    }

    match /browserEarnings/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /browserBrain/{id} {
      allow read, write: if false;
    }
  }
}
